# Production URL of the Express app (no trailing slash).
# Example: https://fs25-companion.onrender.com
APP_URL=http://localhost:3000

# Discord Developer Portal -> your application
DISCORD_CLIENT_ID=YOUR_DISCORD_CLIENT_ID
DISCORD_CLIENT_SECRET=YOUR_DISCORD_CLIENT_SECRET

# Your fixed owner/admin Discord ID
ADMIN_DISCORD_ID=1124793204588433518

# Random, long secret used to sign the HttpOnly session cookie.
# Generate a new value with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# Supabase project settings
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Prefer the new Supabase secret key. Do NOT expose it to the browser.
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY
